  "cards": [
    {
      "dot": "cyan",
      "title": "线程与解耦",
      "items": [
        "Video Worker 与 VLM Worker 是两个 std::jthread，主线程 join 后汇总统计。",
        "BoundedQueue 容量 4~8；队满时淘汰最旧候选，Video Worker 从不等待 VLM。",
        "stop_token 可中断 PTS 等待与出队阻塞，避免进程停止时挂起。"
      ]
    },
    {
      "dot": "emerald",
      "title": "CMake 模块",
      "items": [
        "七个静态库：edge_video、edge_filter、edge_model、edge_skill、edge_agent_core、edge_dashboard、edge_pipeline。",
        "edge_agent 可执行文件只链接 edge_pipeline，模块依赖方向由 src/CMakeLists.txt 固定。",
        "FFmpeg 与 llama.cpp 是外部依赖；GGUF 权重与视频素材不进入仓库。"
      ]
    },
    {
      "dot": "amber",
      "title": "当前运行边界",
      "items": [
        "主入口只加载 LlamaVLM，把非空视觉描述直接 publish_push 到面板。",
        "Skill、ToolRegistry、Agent Loop、LlamaText/Qwen 与 ToolDecisionModel 已编译并有独立测试，但本图没有调用边。",
        "双模型工具决策未接入主入口，运行结果不能作为该能力的验收证据。"
      ]
    }
  ]
