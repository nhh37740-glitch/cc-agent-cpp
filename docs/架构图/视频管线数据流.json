    { "from": "server", "to": "browser", "label": "HTML + BMP", "variant": "emphasis", "route": "vertical-channel" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "内存与代价",
      "items": [
        "筛帧只读取解码帧的 Y 平面，并降采样到 160×90；RGB 转换只发生在候选帧上。",
        "队列容量固定为 4~8，视频管线内存不随视频长度增长。",
        "VLM 处理慢只会让队列淘汰旧候选，不会阻塞 Video Worker。"
      ]
    },
    {
      "dot": "amber",
      "title": "三条丢弃路径",
      "items": [
        "时间门控未到采样间隔：不评估，直接继续读下一帧。",
        "变化分数低于阈值：不进入候选，也不做 RGB 转换。",
        "队列已满：push 淘汰最旧元素，保留最新候选；dropped_full 计数可观测。"
      ]
    },
    {
      "dot": "emerald",
      "title": "面板可见性",
      "items": [
        "DashboardState 先隐藏候选，publish_push 成功后才出现在 /api/state。",
        "历史长度有上限，未推送候选不会挤掉已推送记录。",
        "面板只读：所有请求都是 GET，帧以 BMP 返回。"
      ]
    }
  ]
}
