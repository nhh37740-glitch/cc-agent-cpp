    { "from": "filter", "to": "ydown", "label": "时间门控通过", "variant": "default", "route": "vertical-channel" },
    { "from": "ydown", "to": "diff", "label": "小图对比", "variant": "default", "route": "vertical-channel", "labelAt": [335, 429] },
    { "from": "diff", "to": "drop_low", "label": "score < 0.15", "variant": "dashed", "route": "vertical-channel" },
    { "from": "diff", "to": "rgb", "label": "score ≥ 0.15", "variant": "emphasis", "route": "straight" },
    { "from": "rgb", "to": "candidate", "label": "RGB24 448 宽", "variant": "emphasis", "route": "vertical-channel", "labelAt": [520, 334] },
